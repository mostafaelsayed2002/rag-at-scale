# Copy to .env and fill in. Never commit .env.

# Postgres container: creates this user and database on first start.
# Docker Compose builds the API's DATABASE_URL from these.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rag

# Only for tools run on the host (e.g. ingest). Same password as above.
DATABASE_URL=postgresql://rag:change_me@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# Gemini
GOOGLE_API_KEY=

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-at-scale

# Production compose only: owner of the ghcr.io images
OWNER=
