# The site address. Defaults to plain HTTP on localhost so the routing can be
# tested without certificates. On the server, set SITE_ADDRESS to the domain
# and Caddy obtains and renews a certificate on its own.
{$SITE_ADDRESS:http://localhost} {
	# handle_path strips the matched prefix, so a request for /api/chunks
	# reaches the API as /chunks and the routes need no change.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Everything else is the frontend.
	handle {
		reverse_proxy web:3000
	}
}
